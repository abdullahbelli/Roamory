# Roamory — Örnek Ortam Değişkenleri (.env.example)
# Gerçek bağlantı bilgilerinizi yerel `.env` dosyasına girin (Git'e eklenmez).
# Yalnızca herkese açık publishable key kullanılmalıdır; service_role/secret key KULLANMAYIN.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
